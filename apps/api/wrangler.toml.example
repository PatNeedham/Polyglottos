# Template Wrangler configuration.
# Copy to wrangler.toml and adjust values; the real wrangler.toml is git-ignored.
#
# EKODB_API_KEY is a secret — do NOT commit it. Set it with:
#   wrangler secret put EKODB_API_KEY
# (and again per environment, e.g. `--env production`).

name = "polyglottos-api"
main = "./src/index.ts"
workers_dev = true
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]

[vars]
EKODB_BASE_URL = "https://polyglottos-dev.development.google.ekodb.net"

[env.production]
name = "api-production"
[env.production.vars]
EKODB_BASE_URL = "https://polyglottos-prod.production.google.ekodb.net"

[env.local]
name = "api-local"

[observability]
enabled = true
